GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash
# Optional: Postgres/Supabase connection string. Without it a local SQLite file (roshni.db) is used.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Admin token for the datasheet review queue (/admin)
ADMIN_TOKEN=change-me
# Supabase Auth: the project's public signing keys, used to verify sign-in tokens
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
